DirectoryIndex index.php index.html

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Handle 301 Redirects
    RewriteRule ^m-shot-treatment-kampala-juba/?$ /m-shot-in-juba [NC,R=301,L]
    RewriteRule ^rf-microneedling-kampala-juba/?$ /rf-microneedling-in-juba [NC,R=301,L]
    RewriteRule ^total-sport-iv-therapy-kampala-juba/?$ /total-sport-iv-therapy-in-juba [NC,R=301,L]
    RewriteRule ^pcdc-fat-dissolving-old/?$ /pcdc-fat-dissolving [NC,R=301,L]
    RewriteRule ^dr-chirag-kotecha-dermatologist-in-uganda/?$ /dr-chirag-kotecha [NC,R=301,L]
    RewriteRule ^amino-acids-IV-therapy-treatment-kampala-juba/?$ /amino-acids-iv-therapy [NC,R=301,L]
    RewriteRule ^vitamin-c-treatment-IV-therapy-treatment-kampala-juba/?$ /vitamin-c-iv-therapy [NC,R=301,L]
    RewriteRule ^prp-hair-restoration-kampala-juba/?$ /prp-hair-restoration [NC,R=301,L]
    RewriteRule ^glutathione-IV-therapy-kampala-juba/?$ /glutathione-iv-therapy [NC,R=301,L]
    RewriteRule ^vitiligo-treatment-kampala-juba/?$ /vitiligo-in-juba [NC,R=301,L]
    RewriteRule ^september-glow-deals-bukoto-landing-page/?$ / [NC,R=301,L]
    RewriteRule ^sidebar-temp/?$ / [NC,R=301,L]
    RewriteRule ^ad-footer/?$ / [NC,R=301,L]
    RewriteRule ^performance-and-recovery/?$ / [NC,R=301,L]
    RewriteRule ^index\.html$ / [NC,R=301,L]
    RewriteRule ^sidebar/?$ / [NC,R=301,L]
    RewriteRule ^hydra-new/?$ /hydrafacial [NC,R=301,L]
    RewriteRule ^jinja/?$ / [NC,R=301,L]
    RewriteRule ^juba/?$ / [NC,R=301,L]
    RewriteRule ^testimonials/?$ / [NC,R=301,L]
    RewriteRule ^microblading/?$ / [NC,R=301,L]
    RewriteRule ^hydra-test/?$ /hydrafacial [NC,R=301,L]
    RewriteRule ^images/iv-book3\.pdf$ / [NC,R=301,L]
    RewriteRule ^hydra-temp/?$ /hydrafacial [NC,R=301,L]
    RewriteRule ^co2/?$ /co2-laser-scar-removal [NC,R=301,L]
    RewriteRule ^combo-of-vit-B-12-and-B-complex/?$ /vitamin-b12-iv-therapy [NC,R=301,L]
    RewriteRule ^is-glutathione-the-magic-bullet(/.*)?$ /glutathione-iv-therapy [NC,R=301,L]
    RewriteRule ^service/slender-wonder(/.*)?$ / [NC,R=301,L]
    RewriteRule ^heres-why-your-weight-loss-regimen-isnt-paying-off(/.*)?$ / [NC,R=301,L]
    RewriteRule ^tag/skin-cleansing/feed(/.*)?$ /blog [NC,R=301,L]
    RewriteRule ^-kampala-juba/?$ / [NC,R=301,L]
    RewriteRule ^wp-json/elementskit/v1(/.*)?$ / [NC,R=301,L]
    RewriteRule ^laser-hair-removal-in-uganda-kampala-juba/?$ /laser-hair-removal [NC,R=301,L]
    RewriteRule ^weight-loss-kampala-juba/?$ /semaglutide-ozempic-weight-loss [NC,R=301,L]

    # Explicit routing for Blog index
    RewriteRule ^blog/?$ blog.php [QSA,L]

    # Explicit routing for Blog clean URLs: /blog/article-slug -> blog.php?slug=article-slug
    RewriteRule ^blog/(.+)$ blog.php?slug=$1 [QSA,L]

    # Redirect trailing slashes to non-trailing slashes (except directories)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [R=301,L]

    # Internally route clean extensionless URLs to .php files if file exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>
